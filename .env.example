# ==============================================================================
# SpecPilot Backend Environment Variables (.env)
# 사용법: 이 파일을 복사하여 .env 파일을 생성하세요. ($ cp .env.example .env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI 모델 제공자 설정 (택 1)
# ------------------------------------------------------------------------------

# [옵션 A] Anthropic API 직접 연결 (권장)
SPECPILOT_LLM_PROVIDER=anthropic
SPECPILOT_LLM_MODEL=claude-opus-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-usr-your-api-key-here

# [옵션 B] Vercel AI Gateway 연결
# SPECPILOT_LLM_PROVIDER=vercel
# SPECPILOT_LLM_MODEL=anthropic/claude-3-7-sonnet
# AI_GATEWAY_API_KEY=vck_your_gateway_key_here
# SPECPILOT_LLM_MAX_TOKENS=32000
# SPECPILOT_LLM_TIMEOUT_SECONDS=300

# ------------------------------------------------------------------------------
# 2. 서버 및 데이터베이스 설정 (기본값 권장)
# ------------------------------------------------------------------------------
SPECPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SPECPILOT_DATA_DIR=.data
# SPECPILOT_DATABASE_URL=sqlite:///.data/api.sqlite3
# SPECPILOT_WORKSPACE_ROOT=..

# 한국어 OCR(Tesseract) 언어 데이터 커스텀 경로 (필요 시)
# TESSDATA_PREFIX=/absolute/path/to/tessdata
