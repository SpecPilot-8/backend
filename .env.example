# 선택 설정. 복사한 .env를 API에 적용하려면 uvicorn --env-file .env 를 사용합니다.
# SPECPILOT_DATA_DIR=.data
# SPECPILOT_DATABASE_URL=sqlite:///.data/api.sqlite3
# SPECPILOT_WORKSPACE_ROOT=/absolute/path/to/allowed/workspace
SPECPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 한국어 OCR 언어 데이터가 기본 경로 밖에 있을 때만 지정합니다.
# TESSDATA_PREFIX=/absolute/path/to/tessdata
# 아래 모델 설정은 CLI 어댑터용입니다. 웹의 모델 설정/자동 Job 연결은 별도 작업입니다.
# ANTHROPIC_API_KEY=발급받은_키
# SPECPILOT_LLM_PROVIDER=anthropic
# SPECPILOT_LLM_MODEL=실제로_검증한_모델_ID
# Vercel Gateway를 쓸 때는 아래 항목을 활성화하고 실제 모델 ID를 입력합니다.
# AI_GATEWAY_API_KEY=발급받은_Gateway_키
# SPECPILOT_LLM_PROVIDER=vercel
# SPECPILOT_LLM_MODEL=provider/model-id
# SPECPILOT_LLM_MAX_TOKENS=32000
# SPECPILOT_LLM_TIMEOUT_SECONDS=300
